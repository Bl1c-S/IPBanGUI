<UserControl x:Class="WPF_IPBanUtility.NavigateBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_IPBanUtility"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:NavigateBarViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <local:CurrentPageNameToActiveConverter x:Key="CurrentPageNameConverter" />
            <local:CurrentBorderBrushToActiveConverter x:Key="CurrentBorderBrushConverter" />
        </Grid.Resources>

        <ItemsControl ItemsSource="{Binding NavButtons}" HorizontalAlignment="Left" VerticalAlignment="Center" >
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Button Command="{Binding Button.Command}"
                               Icon="{Binding Button.Icon}"
                               ToolTip="{Binding Button.ToolTip}"
                               Margin="{Binding Button.Margin}">
                        <ui:Button.Content>
                            <MultiBinding Converter="{StaticResource CurrentPageNameConverter}">
                                <Binding Path="CurrentPageName" />
                                <Binding Path="Title" />
                            </MultiBinding>
                        </ui:Button.Content>
                        <ui:Button.BorderBrush>
                            <MultiBinding Converter="{StaticResource CurrentBorderBrushConverter}">
                                <Binding Path="CurrentPageName" />
                                <Binding Path="Title" />
                            </MultiBinding>
                        </ui:Button.BorderBrush>
                    </ui:Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
