<UserControl x:Class="WPF_IPBanUtility.FilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             d:DataContext="{d:DesignInstance Type=local:FilterViewModel}"
             xmlns:local="clr-namespace:WPF_IPBanUtility"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <Grid>
        <Border Style="{StaticResource StandartBorder}" BorderThickness="1,0,0,0" CornerRadius="0" Padding="8,0">
            <StackPanel>
                <Label Content="{Binding Title}" FontSize="16" Margin="0,0,0,5"/>

                <!--Filters-->
                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="{Binding Name}" 
                                          IsChecked="{Binding IsEnable, Mode=TwoWay}" 
                                          VerticalAlignment="Center"
                                          Padding="8,0,0,0"/>

                                <Label Grid.Column="1" 
                                       Content="{Binding Count}" 
                                       Style="{StaticResource StatisticsLabel}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="15,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--Statistics-->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">

                    <Label Content="{Binding AllLogEvent}" 
           Style="{StaticResource StatisticsLabel}" 
           Padding="0,4"/>

                    <Label Content="{Binding ShowedLogEventTitle}" 
           Style="{StaticResource StatisticsLabel}" 
           Margin="15,0,0,0" 
           Padding="0,4"/>

                    <Label Content="{Binding ShowedLogEventCount}" 
           Style="{StaticResource StatisticsLabel}" 
           Margin="5,0,0,0" 
           Padding="0,4"/>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>